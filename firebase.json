{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "**/index.backup-*.html",
      "index-backups-archive-*.tar.gz",
      "n8n/**",
      "docs/**",
      "src/**",
      "scripts/**",
      "tools/**",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "*.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
